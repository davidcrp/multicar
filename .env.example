# Copie para .env.local e preencha. NUNCA suba .env.local para o Git.

# Banco Postgres (Neon). No Vercel, vem automático ao conectar o Neon ao projeto.
DATABASE_URL=

# Token do Vercel Blob (fotos). No Vercel, vem automático ao conectar o Blob ao projeto.
BLOB_READ_WRITE_TOKEN=

# Login do painel /admin
ADMIN_EMAIL=
# Gere com: npm run admin:hash -- "sua senha forte"
ADMIN_PASSWORD_HASH=

# Chave que assina a sessão do admin (mínimo 32 caracteres aleatórios).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Endereço público do site (para links e compartilhamento)
NEXT_PUBLIC_SITE_URL=https://carro-bice.vercel.app
